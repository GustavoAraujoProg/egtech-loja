# Copie este arquivo para ".env" (desenvolvimento local) e configure os MESMOS
# nomes de variável no painel da Vercel (Project Settings > Environment Variables)
# para produção.

# --- Banco de dados (Neon / Postgres) ---
# Pegue em https://neon.tech (ou na integração nativa Vercel > Storage > Postgres)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# --- Sessão de login ---
# Gere um valor aleatório forte, por exemplo rodando no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-valor-aleatorio-bem-grande"

# --- Login com Google (opcional) ---
# Crie em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://SEUDOMINIO.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Asaas (pagamentos) ---
# Pegue a chave em asaas.com > Integrações > API
# Use a URL de sandbox pra testar e troque pra produção só quando for vender de verdade.
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
# ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_API_KEY=""

# Token que você escolhe e cadastra em Asaas > Integrações > Webhooks
# (tem que ser IGUAL nos dois lugares)
ASAAS_WEBHOOK_TOKEN="escolha-um-token-secreto-aqui"
